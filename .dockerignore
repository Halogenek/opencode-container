# Ignore git history
.git
.gitignore

# Ignore documentation (not needed in build context)
README.md
Changelog.md

# Ignore host-only scripts (not copied into image)
build_and_run_opencode_container.sh

# Ignore cursor/editor files
.vscode/
*.swp
*.swo
*~

# Ignore common local files
.env
.env.local
*.log

# Include vendor directory for frozen sources
!vendor/

# Include OpenCode configuration files
!opencode.config
!scripts/secure_opencode_install.sh

