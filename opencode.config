# OpenCode CLI Configuration
# This file contains settings for installing and verifying OpenCode CLI

# Version to install (use specific version, not 'latest')
OPENCODE_VERSION="2.3.2"

# OpenCode v2 is distributed as platform-specific npm packages. The main
# @opencode/cli package is only a launcher, so the container installs and
# verifies the platform binary directly.
OPENCODE_NPM_SCOPE="@opencode"

# SHA256 hashes for the platform packages.
# To get a hash:
# curl -fsSL "https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-${OPENCODE_VERSION}.tgz" | sha256sum
OPENCODE_SHA256_LINUX_X64="845468e35aa5a2b574945a0b96675e64c604f5279ced9aa7245068d8c0b6f6bb"
OPENCODE_SHA256_LINUX_X64_BASELINE="e567dcdb1310dcae4e442077e0d508e10a80c1b996131a04dc9b978cdd26e5cd"
OPENCODE_SHA256_LINUX_ARM64="91a937129efdae8eb8c0c5018ae533f9f35117f26ffd9a4d1f7a5f9da1e69306"

# Installation command used only as a fallback when no hash is configured
OPENCODE_INSTALL_CMD="npm install -g ${OPENCODE_NPM_SCOPE}/cli@${OPENCODE_VERSION}"

# Package registry (default npm registry)
NPM_REGISTRY="https://registry.npmjs.org/"
